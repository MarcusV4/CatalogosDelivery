# Tudo é opcional: sem .env, o docker compose sobe com os valores abaixo.
# Copie para .env apenas se precisar mudar algo.

# Portas expostas no host
RESTAURANTES_PORT=8004
CARDAPIO_PORT=8005
BUSCA_PORT=8006
RESTAURANTES_DB_PORT=5433
CARDAPIO_DB_PORT=5434
FRONTEND_PORT=3000

# Credenciais dos bancos locais (um por serviço)
RESTAURANTES_DB_USERNAME=catalogo
RESTAURANTES_DB_PASSWORD=catalogo
CARDAPIO_DB_USERNAME=catalogo
CARDAPIO_DB_PASSWORD=catalogo

# Opcional: apontar um serviço para um banco externo (ex.: Supabase)
# RESTAURANTES_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# CARDAPIO_DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require

# Seed de desenvolvimento: ativa por padrão apenas nos bancos locais do Compose.
# SEED_ENABLED=false
# SEED_ALLOW_EXTERNAL=true

# CORS: origens que podem chamar as APIs pelo navegador (separadas por vírgula).
# Padrão: http://localhost:5173 (npm run dev) e http://localhost:${FRONTEND_PORT}.
# CATALOGO_CORS_ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:3000

# Identidade (back-end): as escritas de Restaurantes e Cardápio exigem o access token.
# - identidade: valida assinatura (JWKS), iss, aud e exp, e consulta o RBAC (POST /v1/tokens/validar).
#   Sem AUDIENCIAS e RBAC_URL, as escritas respondem 503 (falha fechada).
# - mock: aceita JWT SEM assinatura com sub (UUID) e role. Só para desenvolvimento local.
# CATALOGO_IDENTIDADE_MODO=identidade
# CATALOGO_IDENTIDADE_EMISSOR=http://127.0.0.1:18001
# CATALOGO_IDENTIDADE_JWKS_URI=http://host.docker.internal:18001/.well-known/jwks.json
# CATALOGO_IDENTIDADE_AUDIENCIAS=<aud dos tokens de usuário, combinado com a Equipe 1>
# CATALOGO_IDENTIDADE_RBAC_URL=<URL do serviço de Autorização/RBAC>
# CATALOGO_IDENTIDADE_VALIDACAO_ONLINE=true
# Token de uma conta LOJA para a seed cadastrar os exemplos (no modo mock ela gera um sozinha).
# SEED_TOKEN=

# Front: issuer OAuth e client_id do cliente público PKCE (sem client_secret no navegador).
VITE_API_IDENTIDADE_URL=http://127.0.0.1:18001
VITE_IDENTIDADE_CLIENT_ID=
VITE_IDENTIDADE_REDIRECT_URI=http://localhost:3000/oauth/callback
VITE_IDENTIDADE_SCOPES=
