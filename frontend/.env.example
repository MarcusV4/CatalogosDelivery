# Copie para .env para rodar com `npm run dev`. Os valores são gravados no build
# (o navegador chama as APIs diretamente), então use endereços acessíveis pelo navegador.
VITE_API_RESTAURANTES_URL=http://localhost:8004
VITE_API_CARDAPIO_URL=http://localhost:8005
VITE_API_BUSCA_URL=http://localhost:8006
# Emissor do OAuth local. Registre o callback abaixo como redirect_uri do cliente público PKCE.
VITE_API_IDENTIDADE_URL=http://127.0.0.1:18001
VITE_IDENTIDADE_CLIENT_ID=
VITE_IDENTIDADE_REDIRECT_URI=http://localhost:5173/oauth/callback
# Opcional; informe apenas os escopos de usuário publicados pelo Authorization Server.
VITE_IDENTIDADE_SCOPES=
