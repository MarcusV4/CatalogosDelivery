# Copie para .env para rodar com `npm run dev`. Os valores são gravados no build
# (o navegador chama as APIs diretamente), então use endereços acessíveis pelo navegador.
VITE_API_RESTAURANTES_URL=http://localhost:8004
VITE_API_CARDAPIO_URL=http://localhost:8005
VITE_API_BUSCA_URL=http://localhost:8006
# Reservada para o login com a Identidade (#31); ainda não é usada.
VITE_API_IDENTIDADE_URL=
